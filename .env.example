# Copy this file to .env in the project root (next to docker-compose.yml).
#
#   cp .env.example .env
#
# ---- Proxy (PROXY_*) ----
# Bind-mounted live into the container (read-only, at /etc/ping-linux.env)
# and read fresh by config/pre-scripts on every new shell. NOT used for the
# image build and NOT baked into the container at `docker compose up` time
# — edit it, open a new shell, done. No rebuild, no `docker compose
# up`/`down`, ever required.
#
# PROXY_ACTIVE: "true" to use PROXY_HOST/PROXY_PORT, "false" (or blank) to
# disable. Real string comparison — unlike compose interpolation, "false"
# genuinely means false here.
PROXY_ACTIVE=true
PROXY_HOST=127.0.x.x
PROXY_PORT=8080

# ---- Container resources (VM_*) ----
# Read by docker-compose.yml's deploy.resources.limits via ${VAR}
# substitution at `docker compose up`/build time. Unlike PROXY_*, these ARE
# container-creation attributes — changing them needs `docker compose up
# -d` (recreate) to take effect, and should stay <= what you set in
# .wslconfig (see config/wslconfig.example).
VM_MEMORY=20G
VM_CPUS=12

# ---- Timezone (TZ) ----
# Read by docker-compose.yml's `environment:` via ${VAR} substitution, same
# as VM_* above — a container-creation attribute, so changing it needs
# `docker compose up -d` (recreate) to take effect, not just a new shell.
# Defaults to Asia/Bangkok (Thailand, UTC+7) if unset or blank. The image
# also bakes this same default into its own tzdata config at build time, so
# a standalone/shared copy of the image (no .env mounted) still comes up on
# Thailand time. Use any IANA zone name, e.g. UTC, Asia/Tokyo, America/New_York.
TZ=Asia/Bangkok

# ---- Ingress domain (INGRESS_DOMAIN) ----
# NOT consumed by docker-compose.yml or the Dockerfile — this is for YOU:
# pass it into whatever Helm install/upgrade sets your ingress domain/FQDN
# (check workspace/ia-ext-ciam's chart values.yaml for the exact flag, e.g.
# something like `--set global.domain=$INGRESS_DOMAIN`). It IS already
# available as a plain shell variable in every container shell, though —
# the whole .env file is bind-mounted + `source`d by every new shell (see
# the Dockerfile's /etc/bash.bashrc), the same mechanism pxset/PROXY_* use.
#
# Defaults to a *.nip.io wildcard domain: ANY subdomain of it
# (login.127.0.0.1.nip.io, admin.127.0.0.1.nip.io, ...) resolves straight to
# 127.0.0.1 via public DNS, so multi-hostname setups (separate login/admin/
# etc. hosts, needed for correct SSO cookie-domain scoping) work with zero
# setup — no admin rights, unlike editing
# C:\Windows\System32\drivers\etc\hosts (this repo is no-admin on purpose).
# Needs outbound DNS to resolve nip.io; if that's blocked OR you're fully
# offline (e.g. this PC only has the shared/loaded image, no internet at
# all), nip.io can't resolve here either — and you still can't touch the
# hosts file. Use config/open-edge.bat instead: it maps *.<domain> to
# 127.0.0.1 inside the browser itself (no DNS, no admin, no system files
# touched). Set INGRESS_DOMAIN here to match whatever domain you pass it
# (its own default is "ping.local"):
#   INGRESS_DOMAIN=ping.local
#
# Requires config/kind-config.yaml's ingress port mapping (80/443 -> host)
# and an ingress controller pointed at nodeSelector ingress-ready=true —
# see that file and README.md's Ingress section.
INGRESS_DOMAIN=127.0.0.1.nip.io
